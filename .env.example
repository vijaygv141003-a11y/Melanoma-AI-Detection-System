# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-this-in-production

# Database Configuration
DATABASE_URL=sqlite:///instance/melanoma_detection.db

# Upload Configuration
UPLOAD_FOLDER=static/uploads

# Email Configuration (Optional - for development, these can be left blank)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@melanoma-detection.com

# Model Configuration
MODEL_PATH=model/melanoma_model.h5
LABELS_PATH=model/labels.txt

# Security Configuration
BCRYPT_LOG_ROUNDS=12