# Environment Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# Database
DATABASE_URL=sqlite:///instance/melanoma_detection.db
# For PostgreSQL: postgresql://user:password@localhost:5432/melanoma_db

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@melanoma-detection.com

# Upload Configuration
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB

# Model Configuration
MODEL_PATH=model/melanoma_model.h5
LABELS_PATH=model/labels.txt

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_BUCKET_NAME=melanoma-detection

# Security
BCRYPT_LOG_ROUNDS=12
JWT_SECRET_KEY=your-jwt-secret-key
JWT_EXPIRATION_HOURS=24
